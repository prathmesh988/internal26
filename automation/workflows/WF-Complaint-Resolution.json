{
  "name": "WF-Complaint-Resolution",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "complaint-resolution",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-id",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"{{ $json.body.complaintId || 'UNKNOWN' }}\",\n    \"workflowName\": \"WF-Complaint-Resolution\",\n    \"action\": \"Workflow Started\",\n    \"status\": \"SUCCESS\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $executionId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-start-id",
      "name": "Log Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Validate payload\nconst items = $input.all();\nconst payload = items[0].json.body || {};\nif (!payload.complaintId || !payload.workerId || !payload.resolutionNotes) {\n  throw new Error(\"Missing required fields: complaintId, workerId, or resolutionNotes.\");\n}\nreturn [{ json: { complaintId: payload.complaintId, workerId: payload.workerId, resolutionNotes: payload.resolutionNotes } }];"
      },
      "id": "validate-input-id",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/complaints/documents/{{ $json.complaintId }}",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" }
          ]
        },
        "options": {}
      },
      "id": "fetch-complaint-id",
      "name": "Fetch Complaint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workers/documents/{{ $('Validate Input').first().json.workerId }}",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" }
          ]
        },
        "options": {}
      },
      "id": "fetch-worker-id",
      "name": "Fetch Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Calculate responseTime, resolutionDuration, and append resolution to timeline\nconst complaint = $('Fetch Complaint').first().json;\nconst now = new Date();\nconst created = new Date(complaint.createdAt);\nconst assigned = complaint.assignedAt ? new Date(complaint.assignedAt) : now;\n\nconst responseTime = Math.max(0, Math.round((assigned - created) / 60000));\nconst resolutionDuration = Math.max(0, Math.round((now - created) / 60000));\n\nlet timeline = [];\ntry {\n  timeline = JSON.parse(complaint.timeline || \"[]\");\n} catch (e) {\n  timeline = [];\n}\ntimeline.push({\n  action: \"Resolved\",\n  time: now.toISOString()\n});\n\nreturn [{\n  json: {\n    complaintId: complaint.$id,\n    responseTime,\n    resolutionDuration,\n    timeline: JSON.stringify(timeline)\n  }\n}];"
      },
      "id": "calculate-metrics-id",
      "name": "Calculate Resolution Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/complaints/documents/{{ $json.complaintId }}",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"status\": \"RESOLVED\",\n    \"resolvedAt\": \"{{ new Date().toISOString() }}\",\n    \"resolvedByWorkerId\": \"{{ $('Fetch Worker').first().json.$id }}\",\n    \"resolvedByWorkerName\": \"{{ $('Fetch Worker').first().json.name }}\",\n    \"resolutionNotes\": \"{{ $('Validate Input').first().json.resolutionNotes }}\",\n    \"resolutionDuration\": {{ $json.resolutionDuration }},\n    \"responseTime\": {{ $json.responseTime }},\n    \"timeline\": {{ JSON.stringify($json.timeline) }}\n  }\n}",
        "options": {}
      },
      "id": "update-complaint-id",
      "name": "Update Complaint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workers/documents/{{ $('Fetch Worker').first().json.$id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"data\": {\n    \"isAvailable\": true\n  }\n}",
        "options": {}
      },
      "id": "update-worker-id",
      "name": "Update Worker Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/reward-system",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"citizenId\": \"{{ $('Fetch Complaint').first().json.citizenId }}\",\n  \"points\": 100,\n  \"reason\": \"COMPLAINT\"\n}",
        "options": {}
      },
      "id": "award-reward-id",
      "name": "Award Citizen Reward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/notifications/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"citizenId\": \"{{ $('Fetch Complaint').first().json.citizenId }}\",\n    \"type\": \"COMPLAINT_UPDATE\",\n    \"title\": \"Complaint Resolved\",\n    \"message\": \"Your complaint regarding '{{ $('Fetch Complaint').first().json.title }}' has been marked RESOLVED by worker {{ $('Fetch Worker').first().json.name }}. Resolution Note: {{ $('Validate Input').first().json.resolutionNotes }}\",\n    \"read\": false,\n    \"delivered\": false,\n    \"channel\": \"EMAIL\",\n    \"relatedComplaintId\": \"{{ $('Fetch Complaint').first().json.$id }}\"\n  }\n}",
        "options": {}
      },
      "id": "create-notification-id",
      "name": "Create Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/notification-dispatcher",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"notificationId\": \"{{ $json.$id }}\"\n}",
        "options": {}
      },
      "id": "trigger-dispatcher-id",
      "name": "Trigger Notification Dispatcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"{{ $('Fetch Complaint').first().json.$id }}\",\n    \"workflowName\": \"WF-Complaint-Resolution\",\n    \"action\": \"Workflow Completed\",\n    \"status\": \"SUCCESS\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $executionId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-complete-id",
      "name": "Log Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2300, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Complaint marked as resolved successfully.\",\n  \"complaintId\": \"{{ $('Fetch Complaint').first().json.$id }}\",\n  \"resolutionDuration\": {{ $('Calculate Resolution Metrics').first().json.resolutionDuration }}\n}",
        "options": {}
      },
      "id": "respond-success-id",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2500, 300]
    },
    {
      "parameters": {},
      "id": "error-trigger-id",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [100, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"{{ $json.execution.error.complaintId || 'UNKNOWN' }}\",\n    \"workflowName\": \"WF-Complaint-Resolution\",\n    \"action\": \"Workflow Failed\",\n    \"status\": \"FAILED\",\n    \"message\": \"{{ $json.execution.error.message }}\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $json.execution.id }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-failure-id",
      "name": "Log Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 500]
    },
    {
      "parameters": {
        "fromEmail": "noreply@wasteflow.in",
        "toEmail": "admin@wasteflow.in",
        "subject": "=Workflow Failed: WF-Complaint-Resolution (Execution ID: {{ $json.executionId }})",
        "html": "=<h3>Workflow Execution Failure</h3><p><b>Workflow Name:</b> WF-Complaint-Resolution</p><p><b>Execution ID:</b> {{ $('Log Failure').first().json.data.executionId }}</p><p><b>Error Message:</b> {{ $('Log Failure').first().json.data.message }}</p>",
        "options": {}
      },
      "id": "notify-admin-id",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [500, 500]
    }
  ],
