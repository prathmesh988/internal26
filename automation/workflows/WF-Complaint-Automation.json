            "index": 0
          }
        ]
      ]
    },
    "Check Assignment Result": {
      "main": [
        [
          {
            "node": "Prepare Update Body",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Worker Available",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Update Body": {
      "main": [
        [
          {
            "node": "Update Complaint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Complaint": {
      "main": [
        [
          {
            "node": "Update Worker Availability",
