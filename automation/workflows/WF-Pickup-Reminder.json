{
  "name": "WF-Pickup-Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-id",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"UNKNOWN\",\n    \"workflowName\": \"WF-Pickup-Reminder\",\n    \"action\": \"Workflow Started\",\n    \"status\": \"SUCCESS\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $executionId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-start-id",
      "name": "Log Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/routes/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" }
          ]
        },
        "sendQueryParameters": true,
        "queryParametersUi": {
          "parameter": [
            { "name": "queries[0]", "value": "equal(\"status\", [\"PLANNED\"])" },
            { "name": "queries[1]", "value": "=greaterThan(\"scheduledFor\", \"{{ new Date().toISOString().split('T')[0] }}T00:00:00.000Z\")" },
            { "name": "queries[2]", "value": "=lessThan(\"scheduledFor\", \"{{ new Date().toISOString().split('T')[0] }}T23:59:59.999Z\")" }
          ]
        },
        "options": {}
      },
      "id": "fetch-routes-id",
      "name": "Fetch Today's Routes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "number"
          },
          "conditions": [
            {
              "id": "cond-routes-exist",
              "leftValue": "={{ $json.total }}",
              "comparison": "gt",
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-routes-exist-id",
      "name": "Check Routes Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-in-batches-id",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/citizens/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" }
          ]
        },
        "sendQueryParameters": true,
        "queryParametersUi": {
          "parameter": [
            { "name": "queries[0]", "value": "=equal(\"wardCode\", [\"{{ $('Split In Batches').first().json.wardCode }}\"])" }
          ]
        },
        "options": {}
      },
      "id": "fetch-citizens-id",
      "name": "Fetch Citizens in Ward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1150, 150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "number"
          },
          "conditions": [
            {
              "id": "cond-citizens-exist",
              "leftValue": "={{ $json.total }}",
              "comparison": "gt",
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-citizens-exist-id",
      "name": "Check Citizens Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1350, 150]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Prepare bulk notifications for all citizens in the ward\nconst citizens = $('Fetch Citizens in Ward').first().json.documents || [];\nconst route = $('Split In Batches').first().json;\n\nreturn citizens.map(citizen => ({\n  json: {\n    citizenId: citizen.$id,\n    type: \"PICKUP_REMINDER\",\n    title: \"Daily Waste Collection Reminder\",\n    message: `Hello ${citizen.name}, this is a reminder that the waste collection vehicle on route ${route.name} is scheduled for today. Please segregate wet & dry waste and keep bins ready.`,\n    read: false,\n    delivered: false,\n    channel: \"EMAIL\"\n  }\n}));"
      },
      "id": "prepare-bulk-notif-id",
      "name": "Prepare Bulk Notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1550, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/notifications/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"citizenId\": \"{{ $json.citizenId }}\",\n    \"type\": \"{{ $json.type }}\",\n    \"title\": \"{{ $json.title }}\",\n    \"message\": \"{{ $json.message }}\",\n    \"read\": {{ $json.read }},\n    \"delivered\": {{ $json.delivered }},\n    \"channel\": \"{{ $json.channel }}\"\n  }\n}",
        "options": {}
      },
      "id": "create-notif-id",
      "name": "Create Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1750, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/notification-dispatcher",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"notificationId\": \"{{ $json.$id }}\"\n}",
        "options": {}
      },
      "id": "trigger-dispatcher-id",
      "name": "Trigger Dispatcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1950, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"UNKNOWN\",\n    \"workflowName\": \"WF-Pickup-Reminder\",\n    \"action\": \"Workflow Completed\",\n    \"status\": \"SUCCESS\",\n    \"message\": \"Pickup reminders sent for today's routes.\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $executionId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-complete-id",
      "name": "Log Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1150, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"UNKNOWN\",\n    \"workflowName\": \"WF-Pickup-Reminder\",\n    \"action\": \"Workflow Completed\",\n    \"status\": \"SUCCESS\",\n    \"message\": \"No scheduled routes for today.\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $executionId }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-no-routes-id",
      "name": "Log No Routes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 450]
    },
    {
      "parameters": {},
      "id": "error-trigger-id",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [100, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.appwrite.io/v1/databases/6a540f2e001dfabaccb5/collections/workflow_logs/documents",
        "authentication": "none",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            { "name": "X-Appwrite-Project", "value": "YOUR_PROJECT_ID" },
            { "name": "X-Appwrite-Key", "value": "YOUR_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"complaintId\": \"UNKNOWN\",\n    \"workflowName\": \"WF-Pickup-Reminder\",\n    \"action\": \"Workflow Failed\",\n    \"status\": \"FAILED\",\n    \"message\": \"{{ $json.execution.error.message }}\",\n    \"executedBy\": \"n8n\",\n    \"executionId\": \"{{ $json.execution.id }}\"\n  }\n}",
        "options": {}
      },
      "id": "log-failure-id",
      "name": "Log Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 600]
    },
    {
      "parameters": {
        "fromEmail": "noreply@wasteflow.in",
        "toEmail": "admin@wasteflow.in",
        "subject": "=Workflow Failed: WF-Pickup-Reminder (Execution ID: {{ $json.executionId }})",
        "html": "=<h3>Workflow Execution Failure</h3><p><b>Workflow Name:</b> WF-Pickup-Reminder</p><p><b>Execution ID:</b> {{ $('Log Failure').first().json.data.executionId }}</p><p><b>Error Message:</b> {{ $('Log Failure').first().json.data.message }}</p>",
        "options": {}
      },
      "id": "notify-admin-id",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [500, 600]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Log Start",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Start": {
      "main": [
        [
          {
            "node": "Fetch Today's Routes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Today's Routes": {
      "main": [
        [
          {
            "node": "Check Routes Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Routes Exist": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Routes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches": {
      "main": [
        [
          {
            "node": "Fetch Citizens in Ward",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Citizens in Ward": {
      "main": [
        [
          {
            "node": "Check Citizens Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Citizens Exist": {
      "main": [
        [
          {
            "node": "Prepare Bulk Notifications",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Bulk Notifications": {
      "main": [
        [
          {
            "node": "Create Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Notification": {
      "main": [
        [
          {
            "node": "Trigger Dispatcher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Dispatcher": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Failure": {
      "main": [
        [
          {
            "node": "Notify Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionTimeout": 3600
  }
}
